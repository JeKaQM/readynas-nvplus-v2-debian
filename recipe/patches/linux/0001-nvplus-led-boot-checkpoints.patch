nvplus diagnostics: show zImage entry and end of decompression on the front LEDs (no serial console)

--- a/arch/arm/boot/compressed/head.S	2026-11-02 18:19:50.091842151 +0000
+++ b/arch/arm/boot/compressed/head.S	2026-11-02 18:19:50.103842240 +0000
@@ -221,6 +221,23 @@
 
 		__EFI_HEADER
 1:
+		@ nvplus: LED checkpoint 1 - zImage entered: stop Backup blink, Backup off, Disk3+Disk4 on
+		mov	r3, #0xf1000000
+		orr	r3, r3, #0x10000
+		orr	r3, r3, #0x100	@ GPIO0 0xf1010100
+		ldr	r5, [r3, #8]
+		bic	r5, r5, #(1 << 22)
+		str	r5, [r3, #8]	@ blink off
+		ldr	r5, [r3]
+		orr	r5, r5, #(1 << 22)
+		bic	r5, r5, #(1 << 24)
+		bic	r5, r5, #(1 << 29)
+		str	r5, [r3]	@ LEDs are active low
+		ldr	r5, [r3, #4]
+		bic	r5, r5, #(1 << 22)
+		bic	r5, r5, #(1 << 24)
+		bic	r5, r5, #(1 << 29)
+		str	r5, [r3, #4]	@ output enable
  ARM_BE8(	setend	be		)	@ go BE8 if compiled for BE8
  AR_CLASS(	mrs	r9, cpsr	)
 #ifdef CONFIG_ARM_VIRT_EXT
@@ -639,6 +656,13 @@
 		add	r1, r1, r0		@ end of inflated image
 		bl	cache_clean_flush
 		bl	cache_off
+		@ nvplus: LED checkpoint 2 - kernel inflated: Disk3 off, Disk4 stays on
+		mov	r0, #0xf1000000
+		orr	r0, r0, #0x10000
+		orr	r0, r0, #0x100
+		ldr	r1, [r0]
+		orr	r1, r1, #(1 << 24)
+		str	r1, [r0]
 
 #ifdef CONFIG_ARM_VIRT_EXT
 		mrs	r0, spsr		@ Get saved CPU boot mode
